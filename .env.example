DB_USER=postgres
DB_HOST=localhost
DB_NAME=bowling-tourney
DB_PASSWORD=your-db-password
DB_PORT=5432

# Low-privilege application role (subject to RLS).
# Run `npm run db:setup-user` once to create this role in PostgreSQL.
DB_APP_USER=bowling_app
DB_APP_PASSWORD=your-app-password

NODE_ENV=development
SKIP_AUTH=true
PORT=3000
CORS_ORIGIN=*

AUTH0_AUDIENCE=https://bowling-tournament-api.com
AUTH0_ISSUER_BASE_URL=https://your-auth0-domain.auth0.com/

AUTH0_DOMAIN=your-auth0-domain.auth0.com
AUTH0_MGMT_CLIENT_ID=your-auth0-mgmt-client-id
AUTH0_MGMT_CLIENT_SECRET=your-auth0-mgmt-client-secret
